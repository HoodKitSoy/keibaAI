# .env.example - 環境変数設定テンプレート
# このファイルをコピーして .env として使用してください
# すべてのスクリプトはこの.envファイルから設定を読み込みます（コマンドライン引数は廃止）

# =====================================
# 共通設定
# =====================================
# ランダムシード（再現性確保用）
# - 設定値: 任意の整数（例: 42, 123, 2024）
# - 意味: 乱数生成の初期値を固定し、実験結果の再現性を担保
# - 同じシード値で実行すれば、同じ結果が得られる
SEED=42

# 計算デバイス（GPU/CPU選択）
# - 設定値: "cuda" / "cpu" / 空欄
# - cuda: NVIDIA GPUを使用（高速だがGPU必須）
# - cpu: CPUのみで計算（遅いがどの環境でも動作）
# - 空欄: 自動検出（GPUがあればcuda、なければcpu）
DEVICE=

# =====================================
# [preparing.py] データベースエクスポート設定
# =====================================
# MySQLサーバーのホスト名またはIPアドレス
# - 設定値: "localhost" / "127.0.0.1" / "192.168.x.x" など
# - 意味: JRA-VANデータベースが稼働しているサーバーの場所
DB_HOST=localhost

# MySQLサーバーのポート番号
# - 設定値: 通常は 3306（MySQL標準ポート）
# - 意味: MySQLサーバーが待ち受けているポート
DB_PORT=3306

# MySQLログインユーザー名
# - 設定値: データベースにアクセス権限のあるユーザー名
# - 意味: データベース接続時の認証ユーザー
DB_USER=root

# MySQLログインパスワード
# - 設定値: 上記ユーザーのパスワード
# - 意味: データベース接続時の認証パスワード
DB_PASSWORD=your_password_here

# JRA-VANデータベース名
# - 設定値: 通常は "everydb2"（JRA-VAN標準DB名）
# - 意味: エクスポート対象のデータベース名
DB_NAME=everydb2

# Parquetファイルの出力先ディレクトリ
# - 設定値: 相対パスまたは絶対パス（例: "data/DB", "C:/data/keiba"）
# - 意味: エクスポートしたParquetファイルの保存先
# - このディレクトリに n_*.parquet, s_*.parquet が保存される
PREPARING_OUTPUT_DIR=data/DB

# =====================================
# [preprocessing.py] データ前処理設定
# =====================================
# 処理モード
# - 設定値: "train" / "today" / "date"
# - train: 学習用データ作成（2016-2024年の過去データ、n_テーブル使用）
# - today: 当日予想用データ作成（今日の日付、s_テーブル使用）
# - date: 指定日付の予想用データ作成（PREPROCESSING_TARGET_DATE使用、s_テーブル）
PREPROCESSING_MODE=train

# 対象日付（dateモード時のみ使用）
# - 設定値: YYYYMMDD形式の8桁数字（例: 20241225）
# - 意味: dateモード時に処理する日付を指定
# - trainモード・todayモードでは無視される
PREPROCESSING_TARGET_DATE=

# Parquetファイルの入力元ディレクトリ
# - 設定値: preparing.pyで出力したディレクトリと同じ
# - 意味: n_*.parquet, s_*.parquetが格納されているディレクトリ
PREPROCESSING_DB_DIR=data/DB

# 前処理済みファイルの出力先ディレクトリ
# - 設定値: 相対パスまたは絶対パス
# - 意味: 前処理後のdb_preprocessed_*.parquet, today_preprocessed_*.parquetの保存先
PREPROCESSING_OUTPUT_DIR=data/tmp

# 対象年（trainモード時のみ使用）
# - 設定値: カンマ区切りの年リスト（例: 2016,2017,2018,...,2024）
# - 意味: 学習データに含める年を指定
# - 年を追加/削除することでデータ範囲を調整可能
PREPROCESSING_TARGET_YEARS=2016,2017,2018,2019,2020,2021,2022,2023,2024

# 対象競馬場コード（trainモード時のみ使用）
# - 設定値: カンマ区切りの2桁コードリスト
# - 意味: 学習データに含める競馬場を指定
# - 01:札幌, 02:函館, 03:福島, 04:新潟, 05:東京, 06:中山, 07:中京, 08:京都, 09:阪神, 10:小倉
# - すべて含める場合: 01,02,03,04,05,06,07,08,09,10
# - 特定場のみ: 05,06（東京・中山のみ）など
PREPROCESSING_TARGET_JYO_CDS=01,02,03,04,05,06,07,08,09,10

# =====================================
# [train.py] モデル学習設定
# =====================================
# 前処理済み学習データのファイルパス
# - 設定値: preprocessing.pyが出力したParquetファイルのパス
# - 意味: 学習に使用するデータファイル
TRAIN_INPUT_FILE=data/tmp/db_preprocessed_2016_2024.parquet

# 払戻データのファイルパス
# - 設定値: n_harai.parquetのパス
# - 意味: 払戻金情報（シミュレーション用、現在は未使用）
TRAIN_RETURN_PATH=data/DB/n_harai.parquet

# モデル出力先ディレクトリ
# - 設定値: 相対パスまたは絶対パス
# - 意味: 学習済みモデル、パラメータ、重要度などの保存先
TRAIN_OUTPUT_DIR=models

# 学習タスク
# - 設定値: カンマ区切りのタスクリスト
# - win: 1着予測（二値分類）
# - top3: 3着内予測（二値分類）
# - rank: 着順予測（多クラス分類、1-18着）
# - 複数指定可能（例: win,top3,rank で全タスク実行）
TRAIN_TASKS=win,top3,rank

# 詳細ログ出力フラグ
# - 設定値: true / false
# - true: 詳細なデバッグ情報を出力
# - false: 必要最小限のログのみ出力
TRAIN_VERBOSE=false

# LightGBM設定
# ブースティングラウンド数
# - 設定値: 正の整数（例: 100, 1000, 2000, 5000）
# - 意味: 決定木を何本作成するか
# - 大きいほど精度向上の可能性があるが、過学習リスクも増加
# - 推奨: 2000-3000（早期停止と併用）
LGBM_NUM_BOOST_ROUND=2000

# Early Stopping ラウンド数
# - 設定値: 正の整数（例: 50, 100, 200）
# - 意味: 検証スコアが改善しない状態が何ラウンド続いたら学習を停止するか
# - 過学習防止に有効
# - 推奨: 100-200
LGBM_EARLY_STOPPING_ROUNDS=200

# Optunaハイパーパラメータ探索回数
# - 設定値: 正の整数（例: 10, 50, 100, 200）
# - 意味: 最適なハイパーパラメータを探索する試行回数
# - 多いほど良いパラメータが見つかる可能性が高いが、時間がかかる
# - 推奨: 50-100（デバッグ時は10-20）
LGBM_N_TRIALS=50

# カスタム損失関数
# - 設定値: "none" / "focal"
# - none: LightGBM標準の損失関数を使用
# - focal: Focal Loss（不均衡データ向け、1着予測などで有効）
# - 意味: 損失関数の種類を指定
LGBM_CUSTOM_LOSS=none

# Focal Loss γパラメータ
# - 設定値: 0.0以上の浮動小数点数（例: 1.0, 2.0, 3.0）
# - 意味: 簡単なサンプルの重み付けを調整（大きいほど難しいサンプル重視）
# - LGBM_CUSTOM_LOSS=focal時のみ有効
LGBM_FOCAL_GAMMA=2.0

# Focal Loss αパラメータ
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.25, 0.5, 0.75）
# - 意味: クラス間の重み付けバランス
# - LGBM_CUSTOM_LOSS=focal時のみ有効
LGBM_FOCAL_ALPHA=0.25

# Rankタスクのクラス数
# - 設定値: 正の整数（通常は 18）
# - 意味: 着順予測の最大着順（18頭立てまで対応）
# - データに応じて自動調整されるが、明示的に指定も可能
LGBM_RANK_NUM_CLASS=18

# サンプル抽出比率（デバッグ用）
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.1, 0.5, 1.0）
# - 意味: 学習データの何%を使用するか
# - 1.0: 全データ使用（本番用）
# - 0.1: 10%のみ使用（高速デバッグ用）
LGBM_SAMPLE_FRAC=1.0

# LightGBM学習スキップフラグ
# - 設定値: true / false
# - true: LightGBM学習をスキップし、既存の予測ファイルを使用
# - false: 通常通りLightGBM学習を実行
# - 意味: 強化学習のみを実行したい場合などに使用
LGBM_SKIP=false

# 既存予測ファイルパス（LGBM_SKIP=true時に使用）
# - 設定値: preds_*.parquetのパス、または空欄
# - 意味: LGBM_SKIP=trueの時に読み込む予測結果ファイル
# - LGBM_SKIP=falseの場合は無視される
LGBM_PREDS_PATH=

# WIN5対象レースのみで学習するかどうか
# - 設定値: true / false
# - true: WIN5対象レース（日曜日の5レース）のみで学習
# - false: 全レースで学習（デフォルト）
# - 意味: WIN5予測に特化したモデルを作成する場合に有効化
# - 注意: 学習データ量が大幅に減少します
TRAIN_WIN5_RACES_ONLY=false

# 強化学習 (RL) 設定
# 強化学習の有効化
# - 設定値: true / false
# - true: DQN（Deep Q-Network）を用いた馬券選択学習を実行
# - false: LightGBMのみ実行（強化学習スキップ）
# - 意味: 強化学習ベースのポリシー（RLBetPolicy等）を使用するか
# - 注意: 実験的機能（デフォルトは無効）
RL_ENABLED=false

# 強化学習対象馬券種
# - 設定値: カンマ区切りの券種リスト、または空欄（全券種+WIN5）
# - 選択可能: tansho, fukusho, umaren, umatan, wide, sanrenpuku, sanrentan
# - 空欄: 全券種+WIN5を対象
# - 意味: どの馬券種で強化学習を行うか
RL_BET_TYPES=

# 強化学習エピソード数
# - 設定値: 正の整数（例: 100, 500, 1000）
# - 意味: 学習を何エピソード行うか（1エピソード=学習データ全体を1周）
# - 多いほど学習が進むが、時間がかかる
# - 推奨: 100-500（デバッグ時は10-50）
RL_NUM_EPISODES=100

# 強化学習率
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.0001, 0.001, 0.01）
# - 意味: ニューラルネットワークの学習速度
# - 小さいほど安定するが学習が遅い
# - 推奨: 0.0001-0.001
RL_LEARNING_RATE=0.0001

# 報酬割引率（Gamma）
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.9, 0.95, 0.99）
# - 意味: 将来の報酬をどれだけ重視するか（1.0に近いほど長期的視点）
# - 推奨: 0.95-0.99
RL_GAMMA=0.99

# ε-greedyの初期値
# - 設定値: 0.0-1.0の浮動小数点数（例: 1.0）
# - 意味: 探索（ランダム行動）の初期確率
# - 1.0: 初期は100%ランダム行動
RL_EPSILON_START=1.0

# ε-greedyの最終値
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.01, 0.05, 0.1）
# - 意味: 探索（ランダム行動）の最終確率
# - 小さいほど学習後はモデルの判断を信頼
# - 推奨: 0.01-0.1
RL_EPSILON_END=0.05

# ε減衰率
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.995, 0.999）
# - 意味: εを毎ステップどれだけ減少させるか
# - 1.0に近いほどゆっくり減衰（長期間探索を継続）
# - 推奨: 0.995-0.999
RL_EPSILON_DECAY=0.995

# Experience Replayバッファサイズ
# - 設定値: 正の整数（例: 10000, 100000）
# - 意味: 過去の経験を何件保存するか
# - 大きいほどメモリ使用量が増えるが、学習の安定性が向上
# - 推奨: 10000-100000
RL_BUFFER_SIZE=100000

# バッチサイズ
# - 設定値: 正の整数（例: 32, 64, 128）
# - 意味: 1回の学習で何件のサンプルを使用するか
# - 大きいほど学習が安定するが、メモリ使用量が増える
# - 推奨: 64-128
RL_BATCH_SIZE=64

# Target Networkの更新頻度
# - 設定値: 正の整数（例: 100, 500, 1000）
# - 意味: 何ステップごとにTarget Networkを更新するか
# - Double DQNで学習を安定化させるための仕組み
# - 推奨: 100-1000
RL_TARGET_UPDATE_FREQ=100

# 隠れ層の次元数
# - 設定値: カンマ区切りの整数リスト（例: 256,256,128）
# - 意味: ニューラルネットワークの各隠れ層のニューロン数
# - 大きいほど表現力が高いが、過学習リスクも増加
# - 推奨: 256,256,128 または 128,128,64
RL_HIDDEN_DIMS=256,256,128

# 馬券購入金額（シミュレーション用）
# - 設定値: 正の整数（単位: 円、例: 100, 200）
# - 意味: 1点あたりの購入金額（報酬計算に使用）
# - 通常は100円固定
RL_BET_AMOUNT=100

# 評価間隔
# - 設定値: 正の整数（例: 10, 20, 50）
# - 意味: 何エピソードごとに検証データで評価を行うか
# - 推奨: 10-20
RL_EVAL_INTERVAL=10

# モデル保存間隔
# - 設定値: 正の整数（例: 50, 100）
# - 意味: 何エピソードごとにモデルを保存するか
# - 推奨: 50-100
RL_SAVE_INTERVAL=50

# データ分割設定（年）
# 学習用年範囲
# - 設定値: カンマ区切りの年リスト（例: 2016,2017,...,2022）
# - 意味: モデル学習に使用する年を指定
# - 推奨: 十分な量のデータを確保（5年以上）
TRAIN_YEARS=2016,2017,2018,2019,2020,2021,2022

# 検証用年範囲
# - 設定値: カンマ区切りの年リスト（通常は1年、例: 2023）
# - 意味: ハイパーパラメータ探索と早期停止の判断に使用
# - 学習データと重複しないこと
VALID_YEARS=2023

# テスト用年範囲
# - 設定値: カンマ区切りの年リスト（通常は1年、例: 2024）
# - 意味: 最終的なモデル性能評価に使用
# - 学習・検証データと重複しないこと
TEST_YEARS=2024

# =====================================
# [test.py] モデル評価・シミュレーション設定
# =====================================
# 入力データファイル（TEST_REGENERATE_PREDS=trueの場合に使用）
# - 設定値: 前処理済みParquetファイルのパス
# - 意味: TEST_REGENERATE_PREDS=trueの場合、このファイルからTEST_YEARSでフィルタして
#         学習済みモデルで予測を生成してから評価を実行
TEST_INPUT_FILE=data/tmp/db_preprocessed_2016_2024.parquet

# 予測を再生成するか
# - 設定値: true / false
# - true: TEST_INPUT_FILEから学習済みモデルで予測を生成
# - false: 既存のpreds_*.parquetファイルを使用（デフォルト）
TEST_REGENERATE_PREDS=false

# 予測結果ディレクトリ
# - 設定値: 相対パスまたは絶対パス
# - 意味: train.pyが出力した preds_*.parquet が格納されているディレクトリ
TEST_PREDS_DIR=models/lightgbm

# 評価対象タスク
# - 設定値: カンマ区切りのタスクリスト
# - win: 1着予測の評価
# - top3: 3着内予測の評価
# - rank: 着順予測の評価
# - 複数指定可能（例: win,top3,rank）
TEST_TASKS=win

# 評価結果出力ディレクトリ
# - 設定値: 相対パスまたは絶対パス
# - 意味: 評価結果、比較グラフ、詳細レポートの保存先
TEST_OUTPUT_DIR=models

# 使用するポリシー
# - 設定値: 
#   - all: policy_config.jsonのenabled_policiesを使用
#   - ポリシー名: 特定のポリシーのみ評価（例: BetPolicyCoverage25）
# - 意味: どの賭け戦略でシミュレーションを行うか
TEST_POLICY=all

# policy_config.jsonを使用するか
# - 設定値: true / false
# - true: policy_config.jsonのenabled_policies設定を使用
# - false: TEST_POLICYで指定したポリシーのみ使用
# - 意味: ポリシー設定ファイルの利用有無
TEST_USE_POLICY_CONFIG=true

# ポリシー設定ファイルパス
# - 設定値: 相対パスまたは絶対パス
# - 意味: ポリシー設定（enabled/disabled、パラメータ）を記載したJSONファイル
TEST_POLICY_CONFIG_PATH=policy_config.json

# Rankタスクの閾値（未使用）
# - 設定値: 正の整数
# - 意味: 予約パラメータ（現在は使用されていません）
TEST_RANK_THRESHOLD=1

# グラフ表示フラグ
# - 設定値: true / false
# - true: 評価結果のグラフを画面表示
# - false: グラフをファイル保存のみ（表示しない）
# - 意味: GUI環境でグラフを確認するか
TEST_SHOW_PLOT=false

# TieredCoverageポリシーの閾値
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.35, 0.5, 0.75）
# - 意味: TieredCoverageBetPolicyのカバレッジ閾値
TEST_TIERED_COVERAGE_THRESHOLD=0.5

# レース選別の最小トップスコア
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.3, 0.35, 0.4）
# - 意味: RaceSelectiveポリシーで、1位馬の勝率が何%以上のレースを対象とするか
# - 例: 0.35なら勝率35%以上の1位馬がいるレースのみ馬券購入
TEST_MIN_TOP_SCORE=0.35

# レース選別の最小スコア差
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.05, 0.1, 0.15）
# - 意味: RaceSelectiveポリシーで、1位と2位の勝率差が何%以上のレースを対象とするか
# - 例: 0.1なら1位と2位の勝率差が10%以上のレースのみ馬券購入
TEST_MIN_SCORE_GAP=0.10

# OR条件を使用するか
# - 設定値: true / false
# - true: MIN_TOP_SCOREまたはMIN_SCORE_GAPのいずれかを満たせばレース対象
# - false: 両方の条件を満たす必要あり（AND条件）
# - 意味: レース選別条件の論理結合方法
TEST_USE_OR_CONDITION=false

# WIN5シミュレーション設定
# WIN5シミュレーション有効化
# - 設定値: true / false
# - true: WIN5（5レースの勝ち馬を当てる）のシミュレーションを実行
# - false: WIN5シミュレーションをスキップ
# - 意味: WIN5の評価を行うか
TEST_WIN5_ENABLED=true

# WIN5閾値の最小値
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.01, 0.05）
# - 意味: WIN5で候補馬を選択する最低勝率（最小値）
# - THRESHOLD_MIN～MAXの範囲でスイープして最適閾値を探索
TEST_WIN5_THRESHOLD_MIN=0.01

# WIN5閾値の最大値
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.1, 0.2）
# - 意味: WIN5で候補馬を選択する最低勝率（最大値）
# - THRESHOLD_MIN～MAXの範囲でスイープして最適閾値を探索
TEST_WIN5_THRESHOLD_MAX=0.10

# WIN5閾値のステップ
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.01, 0.02）
# - 意味: WIN5閾値をいくつずつ増やして探索するか
# - 例: MIN=0.01, MAX=0.1, STEP=0.01 → 0.01, 0.02, ..., 0.1 で探索
TEST_WIN5_THRESHOLD_STEP=0.01

# WIN5購入金額（1点あたり）
# - 設定値: 正の整数（単位: 円、例: 100, 200）
# - 意味: WIN5の1組み合わせあたりの購入金額
# - 通常は100円固定
TEST_WIN5_AMOUNT=100

# =====================================
# [predict.py] 当日予測設定
# =====================================
# 予測モード
# - 設定値: today / date
# - today: 本日の日付で予測実行
# - date: PREDICT_TARGET_DATEで指定した日付で予測実行
# - 意味: どの日のレースを予測するか
PREDICT_MODE=today

# 対象日付（MODE=date時に使用）
# - 設定値: YYYYMMDD形式の8桁数字（例: 20241228）、または空欄
# - 意味: date モード時に予測する日付
# - MODE=todayの場合は無視される
PREDICT_TARGET_DATE=

# 学習済みモデルディレクトリ
# - 設定値: 相対パスまたは絶対パス
# - 意味: train.pyが出力した lgbm_*.model が格納されているディレクトリ
PREDICT_MODELS_DIR=models

# 前処理済みデータディレクトリ
# - 設定値: 相対パスまたは絶対パス
# - 意味: preprocessing.py（todayモード）が出力したファイルが格納されているディレクトリ
PREDICT_PREPROCESSED_DIR=data/tmp

# 予測結果出力ディレクトリ
# - 設定値: 相対パスまたは絶対パス
# - 意味: 予測結果、推奨馬券、WIN5推奨の保存先
PREDICT_OUTPUT_DIR=predictions

# 予測タスク
# - 設定値: カンマ区切りのタスクリスト
# - win: 1着確率予測
# - top3: 3着内確率予測
# - rank: 着順確率予測（p1～p18）
# - 複数指定可能（例: win,top3,rank）
PREDICT_TASKS=win,top3,rank

# policy_config.jsonを使用するか
# - 設定値: true / false
# - true: policy_config.jsonのenabled_policies設定を使用
# - false: すべてのポリシーで推奨馬券を生成
# - 意味: ポリシー設定ファイルの利用有無
PREDICT_USE_POLICY_CONFIG=true

# ポリシー設定ファイルパス
# - 設定値: 相対パスまたは絶対パス
# - 意味: ポリシー設定（enabled/disabled、パラメータ）を記載したJSONファイル
PREDICT_POLICY_CONFIG_PATH=policy_config.json

# 詳細ログ出力フラグ
# - 設定値: true / false
# - true: 詳細なデバッグ情報を出力
# - false: 必要最小限のログのみ出力
PREDICT_VERBOSE=false

# 未発走レースのみをフィルタリング
# - 設定値: true / false
# - true: 発走時刻が現在時刻より後のレースのみ予測
# - false: 全レースを予測（過去レースも含む）
# - 意味: auto_predict.py内部で使用（通常はfalse）
PREDICT_FILTER_UNSTARTED=false

# WIN5予測設定
# WIN5予測有効化
# - 設定値: true / false
# - true: WIN5推奨組み合わせを生成
# - false: WIN5予測をスキップ
# - 意味: WIN5の推奨を行うか
PREDICT_WIN5_ENABLED=true

# WIN5閾値
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.1, 0.2, 0.3）
# - 意味: 各レースで勝率が何%以上の馬を候補とするか
# - 例: 0.3なら勝率30%以上の馬を候補として組み合わせ生成
PREDICT_WIN5_THRESHOLD=0.3

# =====================================
# [auto_predict.py] 自動予想システム設定
# =====================================
# メール送信設定
# 送信先メールアドレス
# - 設定値: 有効なメールアドレス（例: your-email@example.com）
# - 意味: 予測結果を送信する宛先
AUTO_PREDICT_EMAIL_TO=your-email@example.com

# 送信元メールアドレス（Gmail推奨）
# - 設定値: 有効なGmailアドレス
# - 意味: 予測結果を送信する送信元アドレス
AUTO_PREDICT_EMAIL_FROM=your-email@gmail.com

# Gmailアプリパスワード
# - 設定値: Gmailのアプリパスワード（16桁）
# - 意味: SMTP認証に使用するパスワード
# - 注意: Googleアカウントで2段階認証を有効化し、アプリパスワードを発行してください
# - 参考: https://support.google.com/accounts/answer/185833
AUTO_PREDICT_EMAIL_PASSWORD=your-app-password-here

# SMTPホスト
# - 設定値: SMTPサーバーのホスト名（Gmailの場合: smtp.gmail.com）
# - 意味: メール送信に使用するSMTPサーバー
AUTO_PREDICT_SMTP_HOST=smtp.gmail.com

# SMTPポート
# - 設定値: 正の整数（Gmailの場合: 587）
# - 意味: SMTP通信に使用するポート番号
# - 587: STARTTLS接続（推奨）
AUTO_PREDICT_SMTP_PORT=587

# 実行間隔（分）
# - 設定値: 正の整数（例: 30, 60, 120）
# - 意味: 何分ごとに予測処理を実行するか
# - 推奨: 30分（レース直前の情報を取得）
AUTO_PREDICT_INTERVAL_MINUTES=30

# DBエクスポート間隔（分）
# - 設定値: 正の整数（例: 30, 60）
# - 意味: 何分ごとにDBエクスポート（preparing.py）を実行するか
# - 推奨: 30分（INTERVAL_MINUTESと同じ）
AUTO_PREDICT_DB_EXPORT_INTERVAL=30

# 出力ディレクトリ（predict.pyと分離）
# - 設定値: 相対パスまたは絶対パス
# - 意味: 自動予測の結果保存先（predict.pyとは別ディレクトリ）
AUTO_PREDICT_OUTPUT_DIR=predictions_auto

# 予測タスク
# - 設定値: カンマ区切りのタスクリスト
# - win: 1着確率予測
# - top3: 3着内確率予測
# - rank: 着順確率予測
# - 複数指定可能（例: win,top3,rank）
AUTO_PREDICT_TASKS=win,top3,rank

# ポリシー設定
# policy_config.jsonを使用するか
# - 設定値: true / false
# - true: policy_config.jsonのenabled_policies設定を使用
# - false: すべてのポリシーで推奨馬券を生成
AUTO_PREDICT_USE_POLICY_CONFIG=true

# ポリシー設定ファイルパス
# - 設定値: 相対パスまたは絶対パス
# - 意味: ポリシー設定（enabled/disabled、パラメータ）を記載したJSONファイル
AUTO_PREDICT_POLICY_CONFIG_PATH=policy_config.json

# WIN5設定
# WIN5予測有効化
# - 設定値: true / false
# - true: WIN5推奨組み合わせを生成
# - false: WIN5予測をスキップ
AUTO_PREDICT_WIN5_ENABLED=true

# WIN5閾値
# - 設定値: 0.0-1.0の浮動小数点数（例: 0.05, 0.1, 0.2）
# - 意味: 各レースで勝率が何%以上の馬を候補とするか
# - 例: 0.1なら勝率10%以上の馬を候補として組み合わせ生成
AUTO_PREDICT_WIN5_THRESHOLD=0.1

# WIN5開始時刻（最初のレースの何分前に処理を開始するか）
# - 設定値: 正の整数（例: 60, 90, 120）
# - 意味: WIN5最初のレースの発走時刻の何分前に予測処理を開始するか
# - 推奨: 60（1時間前）
AUTO_PREDICT_WIN5_START_BEFORE=60

# WIN5通知時刻（各レースの何分前に通知するか）
# - 設定値: 正の整数（例: 10, 15, 20）
# - 意味: WIN5の各レース（5レース）の発走時刻の何分前にメール通知するか
# - 推奨: 15
AUTO_PREDICT_WIN5_NOTIFY_BEFORE=15

# DBエクスポート対象テーブル数
# - 設定値: 正の整数（通常は 13）
# - 意味: preparing.pyでエクスポートするテーブルの数（進捗表示用）
AUTO_PREDICT_DB_TABLE_COUNT=13

# =====================================
# テスト/デバッグ設定（本番運用時はすべてfalseまたは空欄）
# =====================================
# テスト用日付
# - 設定値: YYYYMMDD形式の8桁数字（例: 20241228）、または空欄
# - 空欄: 本日の日付を使用（本番運用）
# - 指定: 指定した日付のデータでテスト実行
# - 意味: 過去の日付でテストを行う場合に使用
AUTO_PREDICT_TEST_DATE=

# テスト用時刻
# - 設定値: HH:MM形式の時刻（例: 10:00, 15:30）、または空欄
# - 空欄: 現在時刻を使用（本番運用）
# - 指定: 指定した時刻として未発走レース判定
# - 意味: 特定時刻での動作をテストする場合に使用
AUTO_PREDICT_TEST_TIME=

# 1回だけ実行してループしない
# - 設定値: true / false
# - true: 1回だけ実行して終了（テスト用）
# - false: INTERVAL_MINUTES ごとに繰り返し実行（本番運用）
# - 意味: デバッグ時に1回だけ実行したい場合に使用
AUTO_PREDICT_ONCE=false

# DBエクスポートをスキップ
# - 設定値: true / false
# - true: preparing.pyをスキップし、既存のParquetファイルを使用
# - false: 通常通りDBエクスポートを実行
# - 意味: デバッグ時に既存データで高速テストしたい場合に使用
AUTO_PREDICT_SKIP_EXPORT=false

# 前処理をスキップ
# - 設定値: true / false
# - true: preprocessing.pyをスキップし、既存の前処理済みファイルを使用
# - false: 通常通り前処理を実行
# - 意味: デバッグ時に既存の前処理済みデータで高速テストしたい場合に使用
AUTO_PREDICT_SKIP_PREPROCESSING=false

# メール送信をスキップ
# - 設定値: true / false
# - true: メール送信せず、ログ出力のみ（テスト用）
# - false: 通常通りメール送信を実行
# - 意味: デバッグ時にメール送信を行わずに動作確認したい場合に使用
AUTO_PREDICT_NO_EMAIL=false

# 全処理をスキップして流れのみ確認
# - 設定値: true / false
# - true: DB/前処理/予測すべてスキップし、フロー確認のみ
# - false: 通常通りすべての処理を実行
# - 意味: システム全体の動作フローを確認したい場合に使用
AUTO_PREDICT_DRY_RUN=false
